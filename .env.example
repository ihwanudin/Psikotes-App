APP_NAME="Psikotes LSI"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psikotes
DB_RUNTIME_USERNAME=psikotes_runtime
DB_RUNTIME_PASSWORD=change-this-runtime-password
DB_OWNER_USERNAME=psikotes_owner
DB_OWNER_PASSWORD=change-this-owner-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REFERRAL_COOKIE_NAME=psikotes_referral
REFERRAL_TTL_DAYS=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IDENTITY_FILESYSTEM_DISK=identity
IDENTITY_FILESYSTEM_DRIVER=local
# Used as the private object prefix when IDENTITY_FILESYSTEM_DRIVER=s3.
IDENTITY_FILESYSTEM_ROOT=identity
PAYMENT_PROOF_FILESYSTEM_DISK=payment-proofs
PAYMENT_PROOF_FILESYSTEM_DRIVER=local
# Used as the private object prefix when PAYMENT_PROOF_FILESYSTEM_DRIVER=s3.
PAYMENT_PROOF_FILESYSTEM_ROOT=payment-proofs
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=150

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-this-development-password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_IMAGE_TAG=dev
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
PARTICIPANT_JWT_SECRET=
TEST_NUMBER_TIMEZONE=Asia/Jakarta

# Signed service-to-service provisioning from Seleksi App.
SELECTION_INTEGRATION_ENABLED=false
SELECTION_INTEGRATION_CLIENT_ID=selection-app
# Use an independent random secret of at least 32 bytes; never reuse APP_KEY.
SELECTION_INTEGRATION_CLIENT_SECRET=
SELECTION_INTEGRATION_BRANCH_REF=BEASISWA-JEPANG
SELECTION_INTEGRATION_INTENDED_FIELD=UMUM
SELECTION_INTEGRATION_TEST_TYPES=ist
SELECTION_INTEGRATION_SIGNATURE_TOLERANCE_SECONDS=300
# Dedicated read boundary Selection -> Psikotes; keep disabled until its route is reviewed and mounted.
SELECTION_RESULT_POLL_ENABLED=false
SELECTION_APP_BASE_URL=https://seleksi.beasiswajepang.id
SELECTION_APP_TIMEOUT_SECONDS=10
# Local development only; HTTP is still restricted to localhost/host.docker.internal.
SELECTION_APP_ALLOW_INSECURE_LOCAL_HTTP=false

# Outbound result callback Psikotes -> Selection. Keep disabled until the
# receiver contract and a separate secret are provisioned in both apps.
SELECTION_RESULT_CALLBACK_ENABLED=false
SELECTION_RESULT_CALLBACK_BASE_URL=https://seleksi.beasiswajepang.id
SELECTION_RESULT_CALLBACK_SECRET=
# Optional during legacy rollout. When set, it is sent and bound into HMAC v2.
SELECTION_RESULT_CALLBACK_KEY_ID=
SELECTION_RESULT_CALLBACK_TIMEOUT_SECONDS=10

# Generic multi-organization integration registry. The database stores only
# credential references; inject the referenced values at runtime as JSON.
# Example shape (never commit a real value): {"lpk-sakura-hmac":"<secret>"}
ASSESSMENT_INTEGRATION_CREDENTIALS_JSON={}
ASSESSMENT_INTEGRATION_SIGNATURE_TOLERANCE_SECONDS=300
ASSESSMENT_INVITATION_TTL_HOURS=168
FILESYSTEM_S3_ENDPOINT=
DRIVE_SA_JSON=
DRIVE_SHARED_FOLDER_ID=
WAHA_URL=
WAHA_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
# Local development only. HTTP remains restricted to loopback and host.docker.internal.
N8N_ALLOW_INSECURE_LOCAL_HTTP=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
SENTRY_DSN=

VITE_APP_NAME="${APP_NAME}"
